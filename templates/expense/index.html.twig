{% extends 'base.html.twig' %}

{% form_theme form _self %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-red-600">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block title %}Expenses{% endblock %}

{% block body %}
<div class="mx-auto max-w-2xl space-y-6 px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900">Expenses</h1>

    <twig:Turbo:Frame id="expenses">
        {% include 'expense/_form.html.twig' %}
    </twig:Turbo:Frame>

    {% include 'expense/_list.html.twig' %}
</div>
{% endblock %}
