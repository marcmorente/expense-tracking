{% extends 'base.html.twig' %}

{% form_theme form _self %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-red-600">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block title %}Expenses{% endblock %}

{% block body %}
<div class="mx-auto max-w-2xl space-y-6 px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900">Expenses</h1>

    <twig:Turbo:Frame id="expenses">
    <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
        {{ form_start(form, {attr: {class: 'space-y-4', novalidate: 'novalidate', 'data-turbo-frame': 'expenses'}}) }}
            {{ form_errors(form) }}

            <div>
                {{ form_label(form.description, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.description, {attr: {class: 'mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div>
                {{ form_label(form.amountInCents, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.amountInCents, {attr: {class: 'mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500'}}) }}
                {{ form_errors(form.amountInCents) }}
            </div>

            <div>
                {{ form_label(form.spentOn, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.spentOn, {attr: {class: 'mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500'}}) }}
                {{ form_errors(form.spentOn) }}
            </div>

            {{ form_widget(form.record, {attr: {class: 'w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2'}}) }}
        {{ form_end(form) }}
    </div>

    <div data-controller="expense-total" class="rounded-xl bg-white shadow-sm ring-1 ring-gray-200">
        <ul class="divide-y divide-gray-100">
            {% for expense in expenses %}
                <li data-expense-total-target="amount" data-amount-in-cents="{{ expense.amountInCents }}" class="flex items-center justify-between px-4 py-3 transition hover:bg-gray-50">
                    <div class="flex items-center gap-4">
                        <time datetime="{{ expense.spentOn|date('Y-m-d') }}" class="min-w-20 text-sm text-gray-500">{{ expense.spentOn|date('M j') }}</time>
                        <span class="expense-description text-sm text-gray-900">{{ expense.description }}</span>
                    </div>
                    <span class="expense-amount inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-sm font-semibold text-blue-700">€{{ (expense.amountInCents / 100)|number_format(2, '.', '') }}</span>
                </li>
            {% else %}
                <li class="expense-empty px-4 py-12 text-center text-sm text-gray-500">No expenses yet. Record your first expense above.</li>
            {% endfor %}
        </ul>

        <div class="flex items-center justify-between border-t border-gray-100 px-4 py-3">
            <span class="text-sm font-medium text-gray-700">Total</span>
            <span class="text-lg font-bold text-gray-900">€ <output data-expense-total-target="total">0.00</output></span>
        </div>
    </div>
    </twig:Turbo:Frame>
</div>
{% endblock %}
