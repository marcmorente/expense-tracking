{% props type = 'success', message = '', dismissible = true, duration = 5000 %}

{% set palette = {
  success: { bg: 'bg-green-50', border: 'border-green-200', text: 'text-green-800', close: 'text-green-700', iconBg: 'bg-green-100', iconText: 'text-green-700', icon: '✓' },
  error: { bg: 'bg-red-50', border: 'border-red-200', text: 'text-red-800', close: 'text-red-700', iconBg: 'bg-red-100', iconText: 'text-red-700', icon: '!' },
  warning: { bg: 'bg-yellow-50', border: 'border-yellow-200', text: 'text-yellow-800', close: 'text-yellow-700', iconBg: 'bg-yellow-100', iconText: 'text-yellow-700', icon: '!' },
  info: { bg: 'bg-blue-50', border: 'border-blue-200', text: 'text-blue-800', close: 'text-blue-700', iconBg: 'bg-blue-100', iconText: 'text-blue-700', icon: 'i' },
}|merge({ _default: { bg: 'bg-gray-50', border: 'border-gray-200', text: 'text-gray-800', close: 'text-gray-700', iconBg: 'bg-gray-100', iconText: 'text-gray-700', icon: 'i' } }) %}

{% set colors = palette[type] ?? palette._default %}
{% set role = type == 'error' ? 'alert' : 'status' %}
{% set live = type == 'error' ? 'assertive' : 'polite' %}

<div
  role="{{ role }}"
  aria-live="{{ live }}"
  class="pointer-events-auto motion-safe:animate-toast-in motion-reduce:animate-none flex w-full items-center gap-3 rounded-xl border px-4 py-3 text-sm shadow-sm ring-1 ring-black/5 {{ colors.bg }} {{ colors.border }} {{ colors.text }}"
  data-controller="toast"
  data-toast-duration-value="{{ duration }}"
  data-action="mouseenter->toast#pointerEnter mouseleave->toast#pointerLeave focusin->toast#focusEnter focusout->toast#focusLeave"
>
  <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold {{ colors.iconBg }} {{ colors.iconText }}">{{ colors.icon }}</span>
  <p class="min-w-0 flex-1 leading-5 font-medium">{{ message }}</p>
  {% if dismissible %}
    <button
      type="button"
      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full {{ colors.close }} transition hover:bg-white/60 hover:opacity-75 focus:outline-none focus:ring-2 focus:ring-current focus:ring-offset-2"
      data-action="click->toast#dismiss"
      aria-label="Close"
    >
      <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  {% endif %}
</div>
