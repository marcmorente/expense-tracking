parameters:
    level: 10
    paths:
        - src/
        - tests/

    reportUnmatchedIgnoredErrors: false

    haspadar:
        testsPaths:
            - */tests/*

        parameterName:
            pattern: '^[a-z][a-zA-Z]{2,}$'

        beImmutable:
            excludedClasses:
                - App\Entity\*

    ignoreErrors:
        # Method/property PHPDoc rules (class-level docblocks only)
        - identifier: haspadar.phpDocMissingMethod
        - identifier: haspadar.phpDocMissingProperty
        - identifier: haspadar.phpDocMissingParam
        - identifier: haspadar.phpDocParamDescription
        - identifier: haspadar.phpdocParamOrder
        - identifier: haspadar.phpDocPunctuationMethod
        - identifier: haspadar.phpDocEmptyMethod
        - identifier: haspadar.returnDescriptionCapital
        - identifier: haspadar.paramDescriptionCapital
        - identifier: haspadar.noPhpDocForOverridden
        - identifier: haspadar.atclauseOrder
        - identifier: haspadar.noLineCommentBeforeDeclaration
        - identifier: haspadar.noInlineComment
